{
  "name": "Product",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "C\u00f3digo do item"
    },
    "name": {
      "type": "string",
      "description": "Nome do item"
    },
    "category": {
      "type": "string",
      "enum": [
        "Mudas",
        "Fertilizantes",
        "Defensivos",
        "Equipamentos",
        "EPIs",
        "Ferramentas",
        "Combust\u00edvel",
        "Outros"
      ],
      "description": "Categoria do produto"
    },
    "unit": {
      "type": "string",
      "enum": [
        "un",
        "kg",
        "litro",
        "caixa",
        "m",
        "m\u00b2",
        "m\u00b3",
        "saco",
        "pct",
        "par"
      ],
      "description": "Unidade de medida"
    },
    "current_stock": {
      "type": "number",
      "default": 0,
      "description": "Estoque atual"
    },
    "min_stock": {
      "type": "number",
      "default": 0,
      "description": "Estoque m\u00ednimo"
    },
    "location": {
      "type": "string",
      "description": "Localiza\u00e7\u00e3o f\u00edsica (ex: Galp\u00e3o A / Prateleira 3)"
    },
    "unit_cost": {
      "type": "number",
      "default": 0,
      "description": "Custo unit\u00e1rio"
    },
    "supplier": {
      "type": "string",
      "description": "Nome do fornecedor"
    },
    "supplier_id": {
      "type": "string",
      "description": "ID do fornecedor (refer\u00eancia)"
    },
    "lead_time_days": {
      "type": "number",
      "default": 7,
      "description": "Lead time em dias"
    },
    "expiration_date": {
      "type": "string",
      "format": "date",
      "description": "Data de validade (quando aplic\u00e1vel)"
    },
    "storage_conditions": {
      "type": "string",
      "description": "Condi\u00e7\u00f5es de armazenagem (ex: refrigerado, protegido da luz)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o adicional"
    },
    "inventory_class": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ],
      "description": "Classe de invent\u00e1rio rotativo ABC"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "category",
    "unit"
  ]
}