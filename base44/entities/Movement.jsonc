{
  "name": "Movement",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "entrada",
        "saida",
        "ajuste",
        "transferencia",
        "perda"
      ],
      "description": "Tipo de movimenta\u00e7\u00e3o"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data"
    },
    "product_id": {
      "type": "string",
      "description": "ID do produto"
    },
    "product_name": {
      "type": "string",
      "description": "Nome do produto (cache)"
    },
    "product_category": {
      "type": "string",
      "description": "Categoria do produto (cache)"
    },
    "quantity": {
      "type": "number",
      "description": "Quantidade"
    },
    "unit_value": {
      "type": "number",
      "description": "Valor unit\u00e1rio"
    },
    "total_value": {
      "type": "number",
      "description": "Valor total"
    },
    "supplier": {
      "type": "string",
      "description": "Fornecedor (entrada)"
    },
    "invoice_number": {
      "type": "string",
      "description": "N\u00famero da nota fiscal"
    },
    "project_id": {
      "type": "string",
      "description": "ID do projeto (sa\u00edda)"
    },
    "project_name": {
      "type": "string",
      "description": "Nome do projeto (cache)"
    },
    "usage_type": {
      "type": "string",
      "enum": [
        "plantio",
        "manuten\u00e7\u00e3o",
        "aplica\u00e7\u00e3o",
        "transporte",
        "administrativo",
        "outro"
      ],
      "description": "Tipo de uso (sa\u00edda)"
    },
    "team_id": {
      "type": "string",
      "description": "ID da equipe (sa\u00edda/perda)"
    },
    "team_name": {
      "type": "string",
      "description": "Nome da equipe (cache)"
    },
    "team_leader": {
      "type": "string",
      "description": "Nome do encarregado da equipe"
    },
    "origin_location": {
      "type": "string",
      "description": "Localiza\u00e7\u00e3o de origem (transfer\u00eancia)"
    },
    "destination_location": {
      "type": "string",
      "description": "Localiza\u00e7\u00e3o de destino (transfer\u00eancia)"
    },
    "loss_reason": {
      "type": "string",
      "description": "Motivo da perda (perda de processo)"
    },
    "responsible": {
      "type": "string",
      "description": "Respons\u00e1vel"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "type",
    "date",
    "product_id",
    "quantity"
  ]
}