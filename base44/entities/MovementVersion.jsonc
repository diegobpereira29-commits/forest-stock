{
  "name": "MovementVersion",
  "type": "object",
  "properties": {
    "movement_id": {
      "type": "string",
      "description": "ID da movimenta\u00e7\u00e3o"
    },
    "version_number": {
      "type": "number",
      "description": "N\u00famero da vers\u00e3o"
    },
    "movement_data": {
      "type": "string",
      "description": "JSON com dados da movimenta\u00e7\u00e3o nesta vers\u00e3o"
    },
    "change_request_id": {
      "type": "string",
      "description": "ID da MovementChangeRequest que gerou esta vers\u00e3o"
    },
    "changed_by": {
      "type": "string",
      "description": "Email do usu\u00e1rio que aprovou a altera\u00e7\u00e3o"
    },
    "changed_at": {
      "type": "string",
      "format": "date",
      "description": "Data da altera\u00e7\u00e3o"
    },
    "change_summary": {
      "type": "string",
      "description": "Resumo das altera\u00e7\u00f5es realizadas"
    },
    "reviewer_notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do revisor"
    }
  },
  "required": [
    "movement_id",
    "version_number",
    "movement_data"
  ]
}