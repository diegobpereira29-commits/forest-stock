{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "supervisor",
        "almoxarife",
        "leitura"
      ],
      "default": "leitura",
      "description": "Fun\u00e7\u00e3o do usu\u00e1rio"
    },
    "employee_id": {
      "type": "string",
      "description": "Matr\u00edcula do funcion\u00e1rio"
    },
    "whatsapp_number": {
      "type": "string",
      "description": "N\u00famero do WhatsApp com c\u00f3digo do pa\u00eds (ex: 5521987654321)"
    },
    "whatsapp_verified": {
      "type": "boolean",
      "default": false,
      "description": "WhatsApp verificado"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Usu\u00e1rio ativo no sistema"
    }
  },
  "required": [
    "employee_id",
    "whatsapp_number"
  ]
}